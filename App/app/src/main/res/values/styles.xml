<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Text.Title" parent="">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="Text.Body" parent="">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="Text.BodyBold" parent="Text.Body">
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Secondary" parent="">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="Text.Section" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="Text.Overline" parent="Text.Section">
        <item name="android:textColor">@color/brand_primary</item>
    </style>

    <style name="Tag" parent="">
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Tag.Primary">
        <item name="android:background">@drawable/bg_tag_primary</item>
        <item name="android:textColor">@color/brand_primary</item>
    </style>
    <style name="Tag.Success">
        <item name="android:background">@drawable/bg_tag_success</item>
        <item name="android:textColor">@color/success</item>
    </style>
    <style name="Tag.Warning">
        <item name="android:background">@drawable/bg_tag_warning</item>
        <item name="android:textColor">@color/warning</item>
    </style>
    <style name="Tag.Danger">
        <item name="android:background">@drawable/bg_tag_danger</item>
        <item name="android:textColor">@color/danger</item>
    </style>

    <style name="Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/bg_surface</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="iconTint">@color/on_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Button.Danger" parent="Button.Primary">
        <item name="backgroundTint">@color/danger</item>
    </style>
    <style name="Button.DangerTonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/danger_container</item>
        <item name="android:textColor">@color/danger</item>
        <item name="iconTint">@color/danger</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/bg_surface_variant</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">12dp</item>
    </style>
    <style name="Button.White" parent="Widget.Material3.Button">
        <item name="backgroundTint">@android:color/white</item>
        <item name="android:textColor">@color/brand_primary_dark</item>
        <item name="iconTint">@color/brand_primary_dark</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Toggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="IconButton" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">9dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/text_secondary</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeColor">@color/stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipCornerRadius">12dp</item>
    </style>

    <style name="TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/bg_surface</item>
        <item name="boxStrokeColor">@color/brand_primary</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/brand_primary</item>
    </style>
    <style name="MyFullCorner">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
