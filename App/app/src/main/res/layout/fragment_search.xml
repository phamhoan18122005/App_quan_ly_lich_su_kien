<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- Banner nhắc nhở (thông báo trong ứng dụng) -->
            <LinearLayout
                android:id="@+id/bannerReminder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_banner"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:drawablePadding="6dp" android:gravity="center_vertical" android:text="@string/banner_app_line" android:textColor="#CBD5E1" android:textSize="11sp" app:drawableStartCompat="@drawable/ic_calendar" app:drawableTint="#CBD5E1" />
                    <ImageButton android:id="@+id/btnBannerClose" android:layout_width="24dp" android:layout_height="24dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/close" android:src="@drawable/ic_close" app:tint="#CBD5E1" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:drawablePadding="6dp" android:gravity="center_vertical" android:text="@string/banner_title" android:textColor="@android:color/white" android:textSize="13sp" android:textStyle="bold" app:drawableStartCompat="@drawable/ic_bell" app:drawableTint="@android:color/white" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/banner_body" android:textColor="#CBD5E1" android:textSize="12sp" />
                <TextView android:id="@+id/btnBannerView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="4dp" android:text="@string/banner_view" android:textColor="#A5B4FC" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- Ô tìm kiếm -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSearch"
                style="@style/TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/search_hint"
                app:endIconMode="clear_text"
                app:startIconDrawable="@drawable/ic_search">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
                <TextView android:id="@+id/tvSearchHint" style="@style/Text.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/search_sqlite_hint" android:textSize="11sp" />
                <TextView android:id="@+id/btnAdvancedFilter" style="@style/Text.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/advanced_filter" android:textColor="@color/brand_primary" android:textStyle="bold" />
            </LinearLayout>

            <!-- Bộ lọc nhanh -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip android:id="@+id/fAll" style="@style/Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="@string/all" />
                    <com.google.android.material.chip.Chip android:id="@+id/fWork" style="@style/Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cat_work" />
                    <com.google.android.material.chip.Chip android:id="@+id/fPersonal" style="@style/Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cat_personal" />
                    <com.google.android.material.chip.Chip android:id="@+id/fFamily" style="@style/Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cat_family" />
                    <com.google.android.material.chip.Chip android:id="@+id/fFriends" style="@style/Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cat_friends" />
                    <com.google.android.material.chip.Chip android:id="@+id/fHealth" style="@style/Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cat_health" />
                    <com.google.android.material.chip.Chip android:id="@+id/fOther" style="@style/Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cat_other" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/tvResultTitle" style="@style/Text.BodyBold" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/search_results" />
                <TextView android:id="@+id/tvSort" style="@style/Text.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/sort_by" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="2"
                tools:listitem="@layout/item_event" />

            <!-- Chi tiết sự kiện đã chọn -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDetail"
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="72dp"
                app:strokeColor="@color/brand_primary">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/card_padding">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView style="@style/Text.Overline" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/selected_detail" />
                        <TextView android:id="@+id/tvDetailTag" style="@style/Tag.Primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cat_work" />
                    </LinearLayout>

                    <TextView android:id="@+id/tvDetailTitle" style="@style/Text.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/sample_detail_title" android:textSize="18sp" />
                    <TextView android:id="@+id/tvDetailDesc" style="@style/Text.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/sample_detail_desc" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_info_box" android:orientation="vertical" android:padding="12dp">
                        <TextView android:id="@+id/tvDetailTime" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:drawablePadding="8dp" android:gravity="center_vertical" android:text="@string/sample_detail_time" app:drawableStartCompat="@drawable/ic_clock" app:drawableTint="@color/brand_primary" />
                        <TextView android:id="@+id/tvDetailDate" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:drawablePadding="8dp" android:gravity="center_vertical" android:text="@string/sample_detail_date" app:drawableStartCompat="@drawable/ic_calendar" app:drawableTint="@color/brand_primary" />
                        <TextView android:id="@+id/tvDetailPlace" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:drawablePadding="8dp" android:gravity="center_vertical" android:text="@string/sample_detail_place" app:drawableStartCompat="@drawable/ic_location" app:drawableTint="@color/brand_primary" />
                        <TextView android:id="@+id/tvDetailReminder" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:drawablePadding="8dp" android:gravity="center_vertical" android:text="@string/sample_detail_reminder" app:drawableStartCompat="@drawable/ic_bell" app:drawableTint="@color/brand_primary" />
                        <TextView android:id="@+id/tvDetailPeople" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:drawablePadding="8dp" android:gravity="center_vertical" android:text="@string/sample_detail_people" app:drawableStartCompat="@drawable/ic_people" app:drawableTint="@color/brand_primary" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnDetailEdit" style="@style/Button.Primary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:layout_weight="1" android:text="@string/edit_event_btn" app:icon="@drawable/ic_edit" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnDetailDelete" style="@style/Button.DangerTonal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:text="@string/delete_event_btn" app:icon="@drawable/ic_delete" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
