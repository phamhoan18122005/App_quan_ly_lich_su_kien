<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/screen_padding"
    android:paddingVertical="8dp">

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_logo"
        android:contentDescription="@string/app_name"
        android:padding="8dp"
        android:src="@drawable/ic_calendar"
        app:tint="@color/on_primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            style="@style/Text.BodyBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvTopSubtitle"
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_calendar"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnSearch"
        style="@style/IconButton"
        android:contentDescription="@string/action_search"
        android:src="@drawable/ic_search" />

    <ImageButton
        android:id="@+id/btnBell"
        style="@style/IconButton"
        android:contentDescription="@string/action_notifications"
        android:src="@drawable/ic_bell" />

    <TextView
        android:id="@+id/tvAvatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_circle_primary"
        android:gravity="center"
        android:text="@string/avatar_letter"
        android:textColor="@color/on_primary"
        android:textStyle="bold" />
</LinearLayout>
